{
  "name": "pasta-lite",
  "version": "0.3.0",
  "description": "Minimal graph-first desktop git client (Electron + git CLI)",
  "keywords": [
    "git",
    "git-client",
    "electron",
    "gui",
    "desktop"
  ],
  "homepage": "https://github.com/SilverClash/pasta-lite-git-client#readme",
  "bugs": {
    "url": "https://github.com/SilverClash/pasta-lite-git-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverClash/pasta-lite-git-client.git"
  },
  "license": "Apache-2.0",
  "author": "Alexey Zhuravlev (https://github.com/SilverClash)",
  "main": "main.js",
  "desktopName": "io.github.silverclash.pastalite.desktop",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "changelog:draft": "node scripts/changelog-draft.js",
    "changelog:check": "node scripts/changelog-pr-check.js",
    "changelog:section": "node scripts/changelog-section.js",
    "release:check": "node scripts/release-check.js",
    "dist:mac": "install-electron && electron-builder --mac",
    "dist:mac:unsigned": "install-electron && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac -c.mac.identity=null -c.mac.forceCodeSigning=false -c.mac.notarize=false",
    "verify:mac": "sh scripts/verify-mac-build.sh",
    "dist:win": "install-electron && electron-builder --win",
    "dist:linux": "install-electron && electron-builder --linux"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "eslint": "10.13.0",
    "globals": "17.13.0"
  },
  "build": {
    "appId": "io.github.silverclash.pastalite",
    "productName": "Pasta Lite Git client",
    "copyright": "Copyright © 2026 Alexey Zhuravlev",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "main/**/*",
      "src/**/*",
      "renderer/**/*",
      "preload.js",
      "preload-tabs.js",
      "assets/icon.icns",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      }
    ],
    "npmRebuild": false,
    "publish": null,
    "beforePack": "scripts/check-extra-resources.js",
    "afterPack": "scripts/mac-adhoc-sign.js",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "resetAdHocDarwinSignature": true
    },
    "afterAllArtifactBuild": "scripts/mac-notarize-dmg.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "artifactName": "Pasta-Lite-${version}-${arch}.${ext}",
      "type": "distribution",
      "identity": "Developer ID Application",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "${productName} ${version}",
      "sign": true,
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Pasta-Lite-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "category": "Development",
      "icon": "assets/icon.icns",
      "executableName": "pasta-lite",
      "executableArgs": ["%F"],
      "syncDesktopName": true,
      "artifactName": "Pasta-Lite-${version}-linux-${arch}.${ext}",
      "maintainer": "Alexey Zhuravlev <info@zhuravlev.biz>"
    },
    "deb": {
      "depends": [
        "git (>= 1:2.51.0)",
        "libasound2",
        "libgbm1",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "buildUniversalInstaller": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pasta Lite",
      "differentialPackage": false,
      "artifactName": "Pasta-Lite-${version}-${arch}-setup.${ext}"
    }
  }
}
